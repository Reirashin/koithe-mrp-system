{
  "info": {
    "name": "MRP Koi Thé - Backend API",
    "description": "Bộ API hệ thống Quản lý Kho & Sản xuất (MRP) - Chi nhánh KOI Thé. Được cập nhật đồng bộ theo từng bước triển khai.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Nguyên vật liệu (NguyenVatLieu)",
